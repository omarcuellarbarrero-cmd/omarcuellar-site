---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
---

<Layout 
  title="Tips de Fallas" 
  description="Tips de diagnóstico para casos puntuales de televisores TRC y LCD/LED. Resuelve fallas reales con guías paso a paso."
>
  <Header slot="header" />

  <Hero
    title="Tips de Fallas TRC y LCD/LED"
    subtitle="Diagnósticos puntuales para casos reales. Más de 30 tips de fallas documentados para resolver rápido."
    ctaText="Ir a TipsTV Pro"
    ctaHref="https://tipstv-v3.omarcuellar.co"
  />

  <section class="section">
    <div class="container" style="max-width: 800px;">
      <div style="display: inline-block; background: #fff3e0; color: #e65100; font-weight: 700; font-size: 0.9rem; padding: 6px 16px; border-radius: 20px; margin-bottom: 20px;">
        ⭐ DE PAGO — Acceso con suscripción
      </div>

      <h2 style="color: var(--institutional-blue); margin-bottom: 20px;">
        ¿Qué incluye TipsTV Pro?
      </h2>

      <div class="grid-2" style="margin-bottom: 40px;">
        <div class="card">
          <h3>🔍 30+ tips de fallas</h3>
          <p>Casos reales documentados: síntoma, causa probable, puntos de prueba y repuesto recomendado. Desde lo más común hasta lo más raro.</p>
        </div>
        <div class="card">
          <h3>⚡ Diagnóstico rápido</h3>
          <p>No pierdas horas probando al azar. Cada tip te lleva directo a la falla con el mínimo de mediciones necesarias.</p>
        </div>
        <div class="card">
          <h3>📋 Fichas técnicas</h3>
          <p>Cada caso incluye modelo, chasis, ICs involucrados, voltajes de referencia y fotos de la placa para identificar componentes.</p>
        </div>
        <div class="card">
          <h3>🔄 Actualizaciones</h3>
          <p>Nuevos tips se agregan regularmente. Si te encuentras un caso nuevo, se puede documentar y agregar a la base.</p>
        </div>
      </div>

      <div class="alert">
        <p><strong>💡 Para técnicos con experiencia:</strong> Si ya dominas los fundamentos y necesitas resolver casos puntuales sin perder tiempo, TipsTV Pro es tu herramienta.</p>
      </div>

      <h3 style="color: var(--institutional-blue); margin: 40px 0 20px;">
        Tipos de fallas cubiertas
      </h3>
      <ul class="feature-list">
        <li>TV TRC: sin imagen, sin sonido, protección, líneas, imagen reducida</li>
        <li>TV LCD/LED: pantalla negra, retroiluminación, T-CON, mainboard</li>
        <li>Fuentes de poder: sin standby, voltajes erráticos, PFC</li>
        <li>Fallos intermitentes: el que enciende a veces y a veces no</li>
        <li>Smart TV: sin WiFi, congelado, no reconoce HDMI</li>
        <li>Casos raros: los que no aparecen en ningún manual</li>
      </ul>

      <div style="text-align: center; margin-top: 48px; padding: 32px; background: var(--light-gray); border-radius: var(--radius);">
        <p style="font-size: 1.15rem; font-weight: 600; color: var(--institutional-blue); margin-bottom: 12px;">
          ¿Quieres resolver fallas reales?
        </p>
        <p style="color: var(--text-muted); margin-bottom: 24px;">
          Accede a TipsTV Pro con tu suscripción.
        </p>
        <a href="https://tipstv-v3.omarcuellar.co" class="btn btn-accent btn-large" target="_blank" rel="noopener noreferrer">
          Abrir TipsTV Pro
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 12px;">
          Requiere cuenta activa
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
