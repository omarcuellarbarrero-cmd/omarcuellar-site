---
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/basico", label: "Básico TRC/LCD" },
  { href: "/tips", label: "Tips de Fallas" },
  { href: "/guia", label: "Guía de Uso" },
];

const currentPath = Astro.url.pathname;
---

<header style="background: var(--deep-blue); position: sticky; top: 0; z-index: 50; box-shadow: 0 2px 8px rgba(0,0,0,0.15); border-bottom: 3px solid #E85D04;">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 20px;">
    <a href="/" style="display: flex; align-items: center; gap: 12px; color: var(--white); font-weight: 700; font-size: 1.2rem; outline: none;">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="40" height="40" rx="10" fill="#123A63"/>
        <rect x="8" y="10" width="24" height="16" rx="2" stroke="#FFFFFF" stroke-width="2" fill="none"/>
        <line x1="14" y1="26" x2="26" y2="26" stroke="#E85D04" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="20" cy="18" r="3" stroke="#FFFFFF" stroke-width="1.5" fill="none"/>
      </svg>
      <span>Omar Cuellar</span>
    </a>

    <nav aria-label="Navegación principal" style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
      {navLinks.map(link => (
        <a 
          href={link.href}
          style={`
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            color: ${currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? "#FFFFFF" : "#D9DDE3"};
            background: ${currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? "#123A63" : "transparent"};
            text-decoration: none;
            transition: all 0.2s;
            white-space: nowrap;
          `}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
