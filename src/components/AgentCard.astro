---
export interface Props {
  title: string;
  description: string;
  features: string[];
  href: string;
  ctaText: string;
  type: "trc" | "lcd";
}

const { title, description, features, href, ctaText, type } = Astro.props;

const accentColor = type === "trc" ? "#123A63" : "#0B223D";
---

<article class="card" style="display: flex; flex-direction: column; height: 100%;">
  <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 16px;">
    <div style={`
      width: 52px; height: 52px; border-radius: 14px; background: ${accentColor};
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    `}>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {type === "trc" ? (
          <>
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </>
        ) : (
          <>
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
            <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01"></path>
          </>
        )}
      </svg>
    </div>
    <h3 style="margin: 0; color: var(--institutional-blue);">{title}</h3>
  </div>

  <p style="color: var(--text-muted); margin-bottom: 20px; flex-grow: 1;">
    {description}
  </p>

  <ul class="feature-list" style="margin-bottom: 24px;">
    {features.map(f => <li>{f}</li>)}
  </ul>

  <a href={href} class="btn btn-primary" style="width: 100%; justify-content: center;">
    {ctaText}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </a>
</article>
